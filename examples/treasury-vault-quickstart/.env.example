# Throwaway Stellar TESTNET secret only (S...). Never a mainnet key.
# Nirium's Agent never sees this value — it is used only to sign locally.
STELLAR_SECRET_KEY=

# Optional: reuse a demo/API key. If unset, the script requests a public
# demo token with your G-address via POST /api/public/demo-auth.
# NIRIUM_API_KEY=

# Optional overrides (defaults are testnet + USDC Blend from /api/treasury/info)
# NIRIUM_BASE_URL=https://nirium-agent.fly.dev
# VAULT_ASSET=usdc
# VAULT_NAME=Quickstart Vault
# VAULT_SYMBOL=QSV
# DEPOSIT_AMOUNT_STROOPS=10000000
# INVEST=false
# VAULT_ID=
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015
