{
    "name": "nirium-routedock-manifest-example",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Serves a signed RouteDock discovery manifest for a Nirium x402 endpoint, without changing how x402Serve() charges for it.",
    "scripts": {
        "dev": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/*.test.ts",
        "testnet-proof:setup": "tsx scripts/setup-testnet-accounts.ts",
        "testnet-proof": "tsx scripts/testnet-proof.ts"
    },
    "dependencies": {
        "@stellar/stellar-sdk": "^14.5.0",
        "@x402/core": "^2.17.0",
        "@x402/express": "^2.17.0",
        "@x402/stellar": "^2.17.0",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "dotenv": "^17.2.3",
        "express": "^4.19.2",
        "nirium": "^0.12.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.0",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0"
    }
}
