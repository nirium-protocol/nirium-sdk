# Stellar secret key (S...) of the account that receives x402 payments.
# This is x402Serve()'s `payTo` account AND the key that signs the RouteDock
# manifest — RouteDock requires the manifest to be signed by the payee itself.
#
# On the real nirium-agent.fly.dev deployment this is Nirium's production
# payee secret and must never leave their own environment. For local dev /
# the testnet proof in scripts/testnet-proof.ts, generate a throwaway
# testnet-only keypair (never a mainnet key):
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
NIRIUM_ROUTEDOCK_PAYEE_SECRET=

# Free per-network key from OpenZeppelin Channels — required even on testnet.
# Get one at https://channels.openzeppelin.com/testnet/gen
FACILITATOR_API_KEY=

# Optional overrides — defaults match the real nirium-agent.fly.dev deployment.
# NIRIUM_X402_NETWORK=stellar:testnet
# NIRIUM_X402_PRICE_USDC=0.02
# PORT=3403

# Used only by scripts/testnet-proof.ts to pay the manifest end-to-end.
# A second, separate testnet keypair funded via https://friendbot.stellar.org
# and holding a USDC trustline. Never reuse the payee secret here.
BUYER_SECRET=
