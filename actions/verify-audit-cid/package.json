{
  "name": "@nirium/verify-audit-cid-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action for verifying Nirium audit CIDs.",
  "main": "dist/index.js",
  "scripts": {
