  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
